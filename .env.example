DJANGO_SECRET_KEY='replace-with-your-own-secret-key'
DJANGO_DEBUG=True
USE_HTTPS=False
LOG_LEVEL=INFO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Render automatically supplies RENDER_EXTERNAL_HOSTNAME; it is added to ALLOWED_HOSTS.

# Optional: takes precedence over DB_* when set.
# DATABASE_URL=postgresql://jobtrack_user:your-database-password@127.0.0.1:5432/jobtrack_db

# Used when DATABASE_URL is unset or empty; also required by local Docker Compose.
DB_NAME=jobtrack_db
DB_USER=jobtrack_user
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
